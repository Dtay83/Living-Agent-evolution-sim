+def embed_text(concept: str) -> list[float]:
+    """Create a deterministic lightweight embedding for local bootstrap runs.
+
+    This avoids the heavy torch dependency pulled by sentence-transformers on
+    Windows. It is not a semantic encoder; replace it with a real embedding
+    provider once the backend is stable and the project lives in a short path.
+    """
+    vector = [0.0] * VECTOR_SIZE
+    tokens = concept.lower().split()
+    for token in tokens:
+        digest = hashlib.sha256(token.encode("utf-8")).digest()
+        index = int.from_bytes(digest[:4], "big") % VECTOR_SIZE
+        sign = 1.0 if digest[4] % 2 == 0 else -1.0
+        vector[index] += sign
+
+    norm = math.sqrt(sum(value * value for value in vector))
+    if norm == 0:
+        return vector
+    return [value / norm for value in vector]
+
